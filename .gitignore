# macOS
.DS_Store

# Editors / IDEs
.vs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/

# AI assistant instructions
.claude
.cursor

