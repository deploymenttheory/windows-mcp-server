{
  "policy": "../enterprise.json",
  "device": { "credential-guard": "fail" },
  "cases": [
    {
      "name": "a shell without Credential Guard is denied",
      "call": { "tool": "PowerShell", "toolset": "shell", "annotations": { "destructive": true } },
      "expect": { "severity": "deny", "failed_signals": ["credential-guard"], "rules": ["credential-guard-for-shell"] }
    },
    {
      "name": "a screenshot does not require Credential Guard",
      "call": { "tool": "Snapshot", "toolset": "screen", "annotations": { "read_only": true } },
      "expect": { "severity": "allow" }
    }
  ]
}
