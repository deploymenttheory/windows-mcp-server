{
  "version": 1,
  "mode": "enforce",
  "signals": {
    "run-context": { "ttl": "0s" },
    "mdm-enrolled": { "ttl": "5m" },
    "secure-boot": { "ttl": "5m" },
    "bitlocker": { "ttl": "60s" }
  },
  "rules": [
    {
      "name": "interactive-session",
      "match": { "toolset": "*" },
      "require": ["run-context"],
      "on_fail": "deny"
    },
    {
      "name": "managed-device",
      "match": { "toolset": "*" },
      "require": ["mdm-enrolled"],
      "on_fail": "deny"
    },
    {
      "name": "startup-admission",
      "match": { "scope": "startup" },
      "require": ["run-context", "mdm-enrolled"],
      "on_fail": "deny"
    },
    {
      "name": "hardware-posture-for-destructive-tools",
      "match": { "annotation": "destructive" },
      "require": ["secure-boot", "bitlocker"],
      "on_fail": "deny"
    }
  ],
  "rate_limits": [
    {
      "name": "destructive-burst",
      "match": { "annotation": "destructive" },
      "window": "10s",
      "max": 3,
      "on_exceed": "deny"
    }
  ],
  "kill": {
    "triggers": {
      "posture_drift": true,
      "rugpull": true,
      "heartbeat_gap": true,
      "sentinel": true
    },
    "actions": {
      "isolate": true,
      "lock": false,
      "shutdown": false
    }
  },
  "transparency": {
    "audit_destination": "stderr",
    "heartbeat": "30s",
    "banner": true
  },
  "inflight": {
    "interval": "60s"
  },
  "enforce_https": true
}
